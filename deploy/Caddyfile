# Harmonic static hosting, Caddy flavour — the lightest self-host option,
# because Caddy gets a Let's Encrypt certificate on its own and HTTPS is a
# hard requirement here (service worker + microphone both need a secure
# context). Same contract as vercel.json and deploy/nginx.conf.
#
#   rsync -a app/dist/ user@server:/srv/harmonic/
#   caddy run --config deploy/Caddyfile
#
# Replace the site address with your domain; :80 works for a LAN demo but the
# mic will be blocked unless you reach it over localhost.

harmonic.example.com {
	root * /srv/harmonic
	encode gzip zstd

	# Content-hashed — safe forever. Unhashed worker/manifest — always revalidate.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /midi-files/* Cache-Control "public, max-age=86400"
	header /sw.js Cache-Control "no-cache"
	header /registerSW.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "no-cache"

	header {
		Permissions-Policy "microphone=(self)"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	try_files {path} /index.html
	file_server
}
