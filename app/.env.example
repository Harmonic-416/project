# Copy to app/.env.local (gitignored). Same Supabase project as the root
# .env.example; paste the anon public key from
# https://supabase.com/dashboard/project/mxfclxntqbeznbubfmwa/settings/api
# Without this file the app still runs — local files only, no cloud library.
VITE_SUPABASE_URL=https://mxfclxntqbeznbubfmwa.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ANON_PUBLIC_KEY_HERE

# Optional. With this set, "Continue with Google" goes to Google and straight
# back to this site, so Google's page names Harmonic's site, not supabase.co.
# Use the same client ID as Supabase -> Authentication -> Google, and list
# this site's address (with the trailing slash, e.g. http://localhost:5173/)
# under "Authorised redirect URIs" on that client in Google Cloud first.
# VITE_GOOGLE_CLIENT_ID=
